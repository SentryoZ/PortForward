{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Port Forward",
  "version": "0.1.0",
  "identifier": "com.paperclip.portforward",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Port Forward",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:portforward.db"]
    }
  }
}
